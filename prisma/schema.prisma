generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum OrganizationType {
  SCHOOL
  EDUCATION_ORGANIZATION
}

enum MembershipRole {
  SCHOOL_ADMIN
  TEACHER
  STUDENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum CurriculumStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum GeneratedDocumentType {
  LESSON_NOTE
  LESSON_PLAN
  EXAMINATION
  QUIZ
  ASSIGNMENT
  REVISION_NOTE
}

enum DocumentStatus {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}

model UserProfile {
  id             String       @id @default(uuid()) @db.Uuid
  authUserId     String?      @unique @db.Uuid
  displayName    String?
  email          String?      @unique
  passwordHash   String?
  platformRole   PlatformRole @default(USER)
  emailVerifiedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships   Membership[]
  authSessions  AuthSession[]
  ownedDocuments GeneratedDocument[] @relation("PersonalDocuments")
}

model AuthSession {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  tokenHash String      @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  type        OrganizationType @default(SCHOOL)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  sessions    AcademicSession[]
  classes     SchoolClass[]
  subjects    Subject[]
  curricula   CurriculumDocument[]
  documents   GeneratedDocument[]
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role, status])
}

model AcademicSession {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  startsAt       DateTime?
  endsAt         DateTime?
  isCurrent      Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  terms          AcademicTerm[]

  @@unique([organizationId, name])
}

model AcademicTerm {
  id        String         @id @default(uuid()) @db.Uuid
  sessionId String         @db.Uuid
  name      String
  startsAt  DateTime?
  endsAt    DateTime?
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, name])
}

model SchoolClass {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  level          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments    ClassEnrollment[]

  @@unique([organizationId, name])
}

model Subject {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  code           String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

model ClassEnrollment {
  id        String      @id @default(uuid()) @db.Uuid
  classId   String      @db.Uuid
  studentId String      @db.Uuid
  createdAt DateTime    @default(now())
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId])
}

model CurriculumDocument {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  title          String
  subjectName    String?
  className      String?
  status         CurriculumStatus @default(DRAFT)
  createdBy      String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       CurriculumVersion[]

  @@index([organizationId, status])
}

model CurriculumVersion {
  id                   String             @id @default(uuid()) @db.Uuid
  curriculumDocumentId String             @db.Uuid
  versionNumber        Int
  sourceFileKey        String?
  extractedText        String?            @db.Text
  approvedAt           DateTime?
  createdAt            DateTime           @default(now())
  document             CurriculumDocument @relation(fields: [curriculumDocumentId], references: [id], onDelete: Cascade)
  topics               CurriculumTopic[]

  @@unique([curriculumDocumentId, versionNumber])
}

model CurriculumTopic {
  id                  String            @id @default(uuid()) @db.Uuid
  curriculumVersionId String            @db.Uuid
  term                String?
  week                String?
  topic               String
  subtopic            String?
  learningObjectives  Json?
  sortOrder           Int               @default(0)
  version             CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)

  @@index([curriculumVersionId, sortOrder])
}

model GeneratedDocument {
  id             String                @id @default(uuid()) @db.Uuid
  ownerUserId    String?               @db.Uuid
  organizationId String?               @db.Uuid
  type           GeneratedDocumentType
  title          String
  status         DocumentStatus        @default(DRAFT)
  subjectName    String?
  className      String?
  topic          String?
  content        Json
  curriculumVersionId String?          @db.Uuid
  schemaVersion  String                @default("1.0")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  owner          UserProfile?          @relation("PersonalDocuments", fields: [ownerUserId], references: [id], onDelete: SetNull)
  organization   Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       DocumentVersion[]

  @@index([ownerUserId, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, type, status])
}

model DocumentVersion {
  id                 String            @id @default(uuid()) @db.Uuid
  documentId         String            @db.Uuid
  versionNumber      Int
  content            Json
  editedBy           String?           @db.Uuid
  createdAt          DateTime          @default(now())
  document           GeneratedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
}

model AiCreditAccount {
  id             String   @id @default(uuid()) @db.Uuid
  ownerUserId    String?  @unique @db.Uuid
  organizationId String?  @unique @db.Uuid
  balance        Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model AiUsageLedger {
  id             String   @id @default(uuid()) @db.Uuid
  ownerUserId    String?  @db.Uuid
  organizationId String?  @db.Uuid
  operation      String
  creditsDelta   Int
  status         String
  idempotencyKey String   @unique
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([ownerUserId, createdAt])
  @@index([organizationId, createdAt])
}
